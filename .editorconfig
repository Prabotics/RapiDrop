root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.swift]
indent_size = 2

[*.{kt,kts}]
indent_size = 4
max_line_length = off
ktlint_standard_max-line-length = disabled

[*.xml]
indent_size = 4
[*.{json,yml,yaml,md}]
indent_size = 2

[Makefile]
indent_style = tab
