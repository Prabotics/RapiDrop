<Window x:Class="RapiDrop.UI.Views.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RapiDrop"
        Width="320"
        MaxHeight="500"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">
    <Grid>
        <Border x:Name="RootBorder"
                CornerRadius="10"
                Background="{DynamicResource BrushCard}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                Padding="12"
                ClipToBounds="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="FlyoutTransform" />
            </Border.RenderTransform>
            <StackPanel>
                <Border x:Name="BannerTransferError"
                        Background="{DynamicResource BrushSquircle}"
                        BorderBrush="#F59E0B"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,5"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtTransferError"
                                   Text="Transfer error"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="✕"
                                Style="{DynamicResource BtnGhost}"
                                FontSize="9"
                                Click="BtnDismissTransferError_Click" />
                    </Grid>
                </Border>
                <Border x:Name="CardTransferProgress"
                        Background="{DynamicResource BrushCard}"
                        BorderBrush="{DynamicResource BrushPulse}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtTransferFileName"
                                       Text="Transferring file..."
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtTransferCounter"
                                       Grid.Column="1"
                                       Text="1/1"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    x:Name="BtnCancelTransfer"
                                    Content="✕"
                                    Style="{DynamicResource BtnGhost}"
                                    FontSize="10"
                                    Width="18" Height="18"
                                    Padding="0"
                                    ToolTip="Cancel transfer"
                                    Click="BtnCancelTransfer_Click" />
                        </Grid>
                        <ProgressBar x:Name="ProgressTransfer"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Foreground="{DynamicResource BrushPulse}"
                                     Background="{DynamicResource BrushSquircle}"
                                     BorderThickness="0"
                                     Margin="0,2,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtTransferBytes"
                                       Text="0 MB / 0 MB"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                            <TextBlock x:Name="TxtTransferSpeed"
                                       Grid.Column="1"
                                       Text=""
                                       FontSize="9.5"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Height="30" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="22" Height="19"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center">
                            <Image.Source>
                                <DrawingImage Drawing="{DynamicResource AppBrandLogo}" />
                            </Image.Source>
                        </Image>
                        <TextBlock Text="RapiDrop"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="0,-1,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="BtnPinWindow"
                            Style="{DynamicResource BtnGhost}"
                            Width="28" Height="28"
                            VerticalAlignment="Center"
                            Margin="0,0,2,0"
                            ToolTip="Pin window open"
                            Click="BtnPinWindow_Click">
                        <Path x:Name="IconPinPath"
                              Data="{DynamicResource IconPin}"
                              Fill="{DynamicResource BrushTextSecondary}"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Button>

                    <Button Grid.Column="2"
                            x:Name="BtnSettings"
                            Style="{DynamicResource BtnGhost}"
                            Width="28" Height="28"
                            VerticalAlignment="Center"
                            ToolTip="Settings"
                            Click="BtnSettings_Click">
                        <Path Data="{DynamicResource IconSettings}"
                              Fill="{DynamicResource BrushTextSecondary}"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Button>
                </Grid>

            <Border x:Name="CardIncomingInvite"
                    Background="{DynamicResource BrushCard}"
                    BorderBrush="{DynamicResource BrushStatusConnected}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusCard}"
                    Padding="12"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36"
                                CornerRadius="{DynamicResource RadiusMedium}"
                                Background="{DynamicResource BrushSurfaceSubtle}"
                                Margin="0,0,10,0">
                            <Path Data="{DynamicResource IconMobile}"
                                  Fill="{DynamicResource BrushStatusConnected}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtIncomingDeviceName"
                                       Text="Device Name"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtIncomingSubtitle"
                                       Text="wants to connect with this PC"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="BorderIncomingPin"
                            Background="{DynamicResource BrushSurfaceSubtle}"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="8,4"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Verification Code"
                                       FontSize="10"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtIncomingPin"
                                       Grid.Column="1"
                                       Text="000 000"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource BrushStatusConnected}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                x:Name="BtnDeclineInvite"
                                Content="Decline"
                                Style="{DynamicResource BtnOutline}"
                                Height="28"
                                FontSize="11"
                                Click="BtnDeclineInvite_Click" />
                        <Button Grid.Column="2"
                                x:Name="BtnAcceptInvite"
                                Content="Accept"
                                Style="{DynamicResource BtnPrimary}"
                                Height="28"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Click="BtnAcceptInvite_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="CardOutgoingPair"
                    Background="{DynamicResource BrushCard}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusCard}"
                    Padding="12"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36"
                                CornerRadius="{DynamicResource RadiusMedium}"
                                Background="{DynamicResource BrushSurfaceSubtle}"
                                Margin="0,0,10,0">
                            <Path Data="{DynamicResource IconMobile}"
                                  Fill="{DynamicResource BrushStatusConnected}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtOutgoingDeviceName"
                                       Text="Device Name"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse Width="6" Height="6"
                                         Fill="{DynamicResource BrushStatusConnected}"
                                         Margin="0,0,5,0"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtOutgoingStatus"
                                           Text="Waiting for approval..."
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="BorderOutgoingPin"
                            Background="{DynamicResource BrushSurfaceSubtle}"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="8,4"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Verification Code"
                                       FontSize="10"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtOutgoingPin"
                                       Grid.Column="1"
                                       Text="000 000"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource BrushStatusConnected}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Button x:Name="BtnCancelOutgoingPair"
                            Content="Cancel"
                            Style="{DynamicResource BtnOutline}"
                            Height="28"
                            FontSize="11"
                            Click="BtnCancelOutgoingPair_Click" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="CardConnectedDevice" Margin="0,0,0,10" Visibility="Collapsed">
                <Border Background="{DynamicResource BrushSurfaceSubtle}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusCard}"
                        Padding="12,10"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="36" Height="36"
                                CornerRadius="8"
                                Background="{DynamicResource BrushBadgeDeviceBg}"
                                BorderBrush="{DynamicResource BrushBadgeDeviceBorder}"
                                BorderThickness="1"
                                Margin="0,0,10,0">
                            <Path x:Name="ConnectedDeviceIconPath"
                                  Data="{DynamicResource IconMobile}"
                                  Fill="{DynamicResource BrushBadgeDeviceFg}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtConnectedDeviceName"
                                       Text="Connected Device"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse x:Name="DotConnectedStatus"
                                         Width="6" Height="6"
                                         Fill="{DynamicResource BrushStatusConnected}"
                                         Margin="0,0,5,0"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtConnectedStatus"
                                           Text="Connected"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource BrushStatusConnected}" />
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2"
                                x:Name="BtnUnpair"
                                Content="Unpair"
                                Style="{DynamicResource BtnPill}"
                                VerticalAlignment="Center"
                                Click="BtnUnpair_Click" />
                    </Grid>
                </Border>

                <StackPanel>
                    <Button x:Name="BtnSendMedia"
                            Style="{DynamicResource BtnActionCard}"
                            Margin="0,0,0,6"
                            Click="BtnSendMedia_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32"
                                    CornerRadius="7"
                                    Background="{DynamicResource BrushBadgeMediaBg}"
                                    BorderBrush="{DynamicResource BrushBadgeMediaBorder}"
                                    BorderThickness="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="IconSendMediaPath"
                                      Data="{DynamicResource IconFolder}"
                                      Fill="{DynamicResource BrushBadgeMediaFg}"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSendMedia"
                                           Text="Send Media"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock x:Name="TxtSendMediaSub"
                                           Text="Share files, photos, or documents"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                            <Path Grid.Column="2"
                                  Data="{DynamicResource IconChevronRight}"
                                  Fill="{DynamicResource BrushTextMuted}"
                                  Width="8" Height="8"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="4,0,2,0" />
                        </Grid>
                    </Button>

                    <Button x:Name="BtnPushClipboard"
                            Style="{DynamicResource BtnActionCard}"
                            Margin="0,0,0,6"
                            Click="BtnPushClipboard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32"
                                    CornerRadius="7"
                                    Background="{DynamicResource BrushBadgeClipBg}"
                                    BorderBrush="{DynamicResource BrushBadgeClipBorder}"
                                    BorderThickness="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="IconPushClipboardPath"
                                      Data="{DynamicResource IconPushClipboard}"
                                      Fill="{DynamicResource BrushBadgeClipFg}"
                                      Width="15" Height="15"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtPushClipboard"
                                           Text="Send Clipboard"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock x:Name="TxtPushClipboardSub"
                                           Text="Send current clipboard content"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                            <Path Grid.Column="2"
                                  Data="{DynamicResource IconChevronRight}"
                                  Fill="{DynamicResource BrushTextMuted}"
                                  Width="8" Height="8"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="4,0,2,0" />
                        </Grid>
                    </Button>

                    <Button x:Name="BtnOpenSyncHistory"
                            Style="{DynamicResource BtnActionCard}"
                            Click="BtnOpenSyncHistory_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32"
                                    CornerRadius="7"
                                    Background="{DynamicResource BrushBadgeHistoryBg}"
                                    BorderBrush="{DynamicResource BrushBadgeHistoryBorder}"
                                    BorderThickness="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <Path Data="{DynamicResource IconHistory}"
                                      Fill="{DynamicResource BrushBadgeHistoryFg}"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Sync History"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="View recent synchronized items"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                            <Path Grid.Column="2"
                                  Data="{DynamicResource IconChevronRight}"
                                  Fill="{DynamicResource BrushTextMuted}"
                                  Width="8" Height="8"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="4,0,2,0" />
                        </Grid>
                    </Button>
                </StackPanel>
            </StackPanel>

            <Border x:Name="CardPairedWaiting"
                    Background="{DynamicResource BrushCanvas}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="30" Height="30"
                            CornerRadius="6"
                            Background="{DynamicResource BrushSquircle}"
                            Margin="0,0,8,0">
                        <Path Data="{DynamicResource IconMobile}"
                              Fill="{DynamicResource BrushTextSecondary}"
                              Width="15" Height="15"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPairedWaitingName"
                                   Text="Device Name"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Waiting for connection on Wi-Fi"
                                   FontSize="10"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            x:Name="BtnUnpairWaiting"
                            Content="Unpair"
                            Style="{DynamicResource BtnGhost}"
                            FontSize="10.5"
                            VerticalAlignment="Center"
                            Click="BtnUnpair_Click" />
                </Grid>
            </Border>

            <StackPanel x:Name="SectionDiscoveredDevices" Margin="0,0,0,10">
                <TextBlock x:Name="TxtDiscoveredHeader"
                           Text="Nearby devices"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           Margin="0,0,0,6" />

                <Border x:Name="CardSearchingDevices"
                        Background="{DynamicResource BrushSurfaceSubtle}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusMedium}"
                        Padding="12"
                        Margin="0,0,0,6">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{DynamicResource IconPeerWave}"
                              Fill="{DynamicResource BrushTextMuted}"
                              Width="18" Height="18"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,6" />
                        <TextBlock Text="No nearby devices found"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,2" />
                        <TextBlock Text="Make sure RapiDrop is open on your other device and connected to the same Wi-Fi network."
                                   FontSize="10"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ScrollViewer MaxHeight="270"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              Margin="0,0,0,2">
                    <StackPanel x:Name="PanelDiscoveredDevices" />
                </ScrollViewer>
            </StackPanel>

            <Grid x:Name="SectionHistoryHeader" Margin="0,0,0,10" Visibility="Collapsed">
                <Button x:Name="BtnBackToPairedDevice"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource BtnPill}"
                        Height="26"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Click="BtnBackToPairedDevice_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{DynamicResource IconChevronRight}"
                              Fill="{DynamicResource BrushTextSecondary}"
                              Width="7" Height="7"
                              Stretch="Uniform"
                              RenderTransformOrigin="0.5,0.5"
                              Margin="0,0,5,0"
                              VerticalAlignment="Center">
                            <Path.RenderTransform>
                                <RotateTransform Angle="180" />
                            </Path.RenderTransform>
                        </Path>
                        <TextBlock Text="Back" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Text="Sync History"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <Button x:Name="BtnClearHistory"
                        HorizontalAlignment="Right"
                        Content="Clear"
                        Style="{DynamicResource BtnGhost}"
                        FontSize="11"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Click="BtnClearHistory_Click" />
            </Grid>

            <Border x:Name="CardEmptyHistory"
                    Background="{DynamicResource BrushSurfaceSubtle}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusCard}"
                    Padding="16,22"
                    Margin="0,0,0,6"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="40" Height="40"
                            CornerRadius="8"
                            Background="{DynamicResource BrushCard}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10">
                        <Path Data="{DynamicResource IconPushClipboard}"
                              Fill="{DynamicResource BrushTextSecondary}"
                              Width="18" Height="18"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No Clipboard History"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Items you copy on this PC or paired devices will sync and appear here automatically."
                               FontSize="10"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               MaxWidth="240"
                               Margin="0,0,0,10" />
                    <Border Background="{DynamicResource BrushCard}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,3"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="5" Height="5"
                                     Fill="{DynamicResource BrushStatusConnected}"
                                     Margin="0,0,5,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="Direct clipboard sync active"
                                       FontSize="9.5"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="BorderSearchClips"
                    Background="{DynamicResource BrushSurfaceSubtle}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,5"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0"
                          Data="{DynamicResource IconSearch}"
                          Fill="{DynamicResource BrushTextMuted}"
                          Width="12" Height="12"
                          Stretch="Uniform"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center" />
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSearchPlaceholder"
                                   Text="Search clipboard history..."
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <TextBox x:Name="TxtSearchClips"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="11"
                                 Foreground="{DynamicResource BrushTextPrimary}"
                                 VerticalAlignment="Center"
                                 TextChanged="TxtSearchClips_TextChanged" />
                    </Grid>
                    <Button Grid.Column="2"
                            x:Name="BtnClearSearch"
                            Content="✕"
                            Style="{DynamicResource BtnGhost}"
                            FontSize="9"
                            Width="16" Height="16"
                            Padding="0"
                            Visibility="Collapsed"
                            Click="BtnClearSearch_Click" />
                </Grid>
            </Border>

            <UniformGrid x:Name="GridFilters" Columns="4" Margin="0,0,0,8">
                <Button x:Name="BtnFilterAll" Content="All" Style="{DynamicResource BtnPill}" FontSize="10" Height="24" Margin="0,0,2,0" Click="BtnFilter_Click" Tag="All" />
                <Button x:Name="BtnFilterText" Content="Text" Style="{DynamicResource BtnGhost}" FontSize="10" Height="24" Margin="2,0,2,0" Click="BtnFilter_Click" Tag="Text" />
                <Button x:Name="BtnFilterLinks" Content="Links" Style="{DynamicResource BtnGhost}" FontSize="10" Height="24" Margin="2,0,2,0" Click="BtnFilter_Click" Tag="Url" />
                <Button x:Name="BtnFilterMedia" Content="Media" Style="{DynamicResource BtnGhost}" FontSize="10" Height="24" Margin="2,0,0,0" Click="BtnFilter_Click" Tag="Media" />
            </UniformGrid>

            <Border x:Name="CardDirectSync"
                    Background="{DynamicResource BrushSurfaceSubtle}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusCard}"
                    Padding="12"
                    Margin="0,0,0,8"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Path Data="{DynamicResource IconLock}"
                              Fill="{DynamicResource BrushTextSecondary}"
                              Width="12" Height="12"
                              Margin="0,0,6,0"
                              Stretch="Uniform" />
                        <TextBlock Text="Direct Clipboard Sync"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                    </StackPanel>
                    <TextBlock Text="Clips sync instantly in memory. History is paused."
                               Foreground="{DynamicResource BrushTextSecondary}"
                               FontSize="10"
                               TextWrapping="Wrap" />
                    <Button x:Name="BtnTurnOnHistory"
                            Content="Turn on History"
                            Style="{DynamicResource BtnOutline}"
                            FontSize="10.5"
                            FontWeight="Medium"
                            Height="26"
                            Padding="10,0"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Click="BtnTurnOnHistory_Click" />
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="ScrollClips"
                          MaxHeight="260"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,6">
                <StackPanel x:Name="PanelClips" />
            </ScrollViewer>
            </StackPanel>
        </Border>

        <Border x:Name="OverlayDropTarget"
                CornerRadius="10"
                Background="{DynamicResource BrushCard}"
                BorderBrush="{DynamicResource BrushPulse}"
                BorderThickness="2"
                Padding="16"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="{DynamicResource IconSendMedia}"
                      Fill="{DynamicResource BrushPulse}"
                      Width="28" Height="28"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,8" />
                <TextBlock x:Name="TxtDropPrompt"
                           Text="Drop file to send to device"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
