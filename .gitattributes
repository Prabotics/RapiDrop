# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Shell scripts must have LF line endings
*.sh text eol=lf
gradlew text eol=lf

# Windows batch and PowerShell scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.aar binary
*.apk binary
*.aab binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.dmg binary
